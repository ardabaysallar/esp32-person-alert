// Copy this file to "secrets.h" (setup.sh does it for you) and fill in your values.
// secrets.h is listed in .gitignore. Never commit it, share it or post a screenshot of it.

// Gmail account the camera sends FROM. Use a separate throwaway account, not your main one.
#define SENDER_EMAIL     "your.camera.account@gmail.com"

// 16-character Gmail app password (Google Account > Security > 2-Step Verification > App passwords).
// Not your normal Google password.
#define SENDER_APP_PASS  "PASTE-16-CHAR-APP-PASSWORD-HERE"

// Address that receives the alerts.
#define RECIPIENT_EMAIL  "PUT-YOUR-MAIN-EMAIL-HERE"
